{
  "name": "tracelayer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "packages/aml-engine"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev --workspace @tracelayer/frontend",
    "dev:backend": "npm run dev --workspace @tracelayer/backend",
    "build": "npm run build --workspace @tracelayer/frontend",
    "lint": "npm run lint --workspace @tracelayer/frontend && npm run lint --workspace @tracelayer/backend && npm run lint --workspace @tracelayer/aml-engine",
    "test": "node --import tsx --test packages/aml-engine/tests/*.test.ts",
    "clean": "npm run clean --workspace @tracelayer/frontend"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
